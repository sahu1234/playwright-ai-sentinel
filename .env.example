# ============================================================================
# ZERO-COST DUAL AI CONFIGURATION
# Default: Local Ollama (http://localhost:11434/v1 with qwen2.5-coder:7b)
# CI Mode: Groq Free Tier (https://api.groq.com/openai/v1 with llama-3.3-70b-versatile)
# ============================================================================

# Local Ollama Defaults
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5-coder:7b

# Uncomment below for Groq Cloud Inference (or set via GitHub Actions Secrets)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your_free_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Self-Healing Toggle (set to "true" to enable DOM self-healing on locator failure)
AI_HEAL=true

# Optional: Override practice site hostname if needed
# Practice routes live on https://practice.expandtesting.com
PRACTICE_ORIGIN=https://practice.expandtesting.com
